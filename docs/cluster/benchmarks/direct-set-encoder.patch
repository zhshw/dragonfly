+  // A single SET is one DefaultRecord with null key, offset delta 0 and no record headers.
+  auto varint = [](size_t n) {
+    string out;
+    uint32_t raw = static_cast<uint32_t>(n) << 1;
+    while (raw >= 128) {
+      out.push_back(static_cast<char>((raw & 0x7f) | 0x80));
